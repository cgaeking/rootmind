# RootMind backend environment variables.
# Copy to .env (gitignored) in the directory you start the backend from.

# --- Read from .env or the environment -----------------------------------------
# Set the key for the provider you use; leave the others empty.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
# Config file (default: config.yaml under RLM_HOME or the working directory).
# CONFIG_PATH=config.yaml

# --- Read from the process environment only (not from .env) ---------------------
# Folder for config.yaml and data/ (default: the working directory).
#   RLM_HOME=
# Serve only, never index in this process (e.g. a second process on the same database).
#   RLM_DISABLE_SCHEDULER=1
# Bearer token for the MCP HTTP server. When unset, a random token is generated
# on first start and stored in <RLM_HOME>/data/api_token.txt. When set but
# empty, the server refuses to start (fail closed).
#   MCP_API_TOKEN=
# Extra browser origins allowed to call the MCP HTTP server (comma-separated).
#   MCP_ALLOWED_ORIGINS=
