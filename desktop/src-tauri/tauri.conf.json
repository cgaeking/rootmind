{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RootMind",
  "version": "../package.json",
  "identifier": "io.github.cgaeking.rootmind",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RootMind",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:*; img-src 'self'; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Christian Gäking",
    "homepage": "https://github.com/cgaeking/rootmind",
    "copyright": "Copyright (c) 2026 Christian Gäking",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["English", "German"],
        "template": "installer/installer.nsi",
        "installerHooks": "installer/hooks.nsh"
      }
    }
  }
}
